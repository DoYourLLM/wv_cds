# Development notes - internal design records, deliberately not published.
# The package README still lists docs/ as "safe to delete"; it simply will
# not be in the repository.
docs/

# Python bytecode
__pycache__/
*.py[cod]

# Logs, editor leftovers, scratch files
*.log
*.swp
*.swo
*~
*.tmp

# wv writes its own log wherever it was started from, and rotates it to
# sxcmd.log.1, .2, ... The header carries the host name, user id and PID, and
# the body carries absolute paths - none of which belongs in a public repo.
# Note that *.log above does NOT match sxcmd.log.1.
sxcmd.log*

# PostScript dumps from wv's print-to-file; they embed the originating path
# and date. This package ships no .ps files of its own.
*.ps

# Screen recordings. A capture of a working session shows a real schematic -
# net names, block names, possibly PDK and customer data - none of which the
# READMEs reference or the package needs. Kept out by default so that a
# "git add -A" cannot publish 25 MB of someone's design. If a demo really
# should ship, review the frames first and force-add it.
*.mp4
*.mov
*.mkv
video/
